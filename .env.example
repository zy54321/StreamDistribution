# Buffer 官方 GraphQL。在 https://publish.buffer.com/settings/api 创建 Access Token。
BUFFER_API_KEY=

# Cloudflare R2，S3 兼容。公开直链用自定义域或 r2.dev 域，不要带末尾斜杠也可以。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://cdn.example.com

# OpenAI 兼容接口。DeepSeek 示例：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 勾选「附带站点链接」时写入草稿的 URL。
SITE_LINK=https://qingsys.com/en
